# Seitz.co.za Environment Variables

# Site Configuration
NEXT_PUBLIC_SITE_URL=https://seitz.co.za

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Transactional Email (Resend / SMTP)
RESEND_API_KEY=re_your_api_key_here
CONTACT_NOTIFICATION_EMAIL=byseitz.agency@gmail.com

# OpenRouter LLM
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_MODEL=google/gemini-2.0-flash-001

# Google APIs (Google Play Developer Publishing API / Google Groups)
GOOGLE_PLAY_STORE_API_KEY=your-google-play-api-key
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
